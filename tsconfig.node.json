{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "allowJs": true,
    "outDir": "dist"
  },
  "include": [
    "vite.config.js",
    "vitest.config.js",
    "playwright.config.js",
    "public/manifest.json"
  ]
}