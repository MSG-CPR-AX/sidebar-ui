{
  "manifest_version": 3,
  "name": "SideBeam✨",
  "version": "1.0",
  "description": "Bookmark sharing application for closed-network Chrome users with GitLab integration",
  "permissions": [
    "storage",
    "sidePanel",
    "bookmarks"
  ],
  "host_permissions": [
    "https://*/"
  ],
  "action": {
    "default_title": "Open SideBeam bookmark panel"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https:; font-src 'self' data:;"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}