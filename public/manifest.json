{
  "manifest_version": 3,
  "name": "Sidebeam",
  "version": "1.0",
  "description": "A bookmark sharing application for the Chrome side panel.",
  "permissions": [
    "sidePanel",
    "bookmarks",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open Sidebeam"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
