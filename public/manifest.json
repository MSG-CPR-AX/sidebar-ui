{
  "name": "Bookmark Side Panel",
  "description": "Share and manage bookmarks across closed networks via GitLab‑managed YAML files.",
  "version": "1.0.0",
  "manifest_version": 3,
  "permissions": ["bookmarks", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bookmarks"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}